{
  "name": "ig-request-cancel-tool",
  "version": "1.0.0",
  "description": "Instagram İstek İptal Aracı",
  "main": "main.js",
  "author": "Hudayfa Terler",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win portable"
  },
  "dependencies": {
    "cheerio": "^1.0.0",
    "playwright": "^1.54.1"
  },
  "devDependencies": {
    "electron": "^37.2.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.hudayfa.igrequestcanceltool",
    "productName": "IG Request Cancel Tool",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "renderer/**/*",
      "src/**/*",
      "icon.ico",
      "package.json"
    ],
    "win": {
      "icon": "icon.ico",
      "target": [
        "portable"
      ]
    },
    "portable": {
      "artifactName": "IG-Request-Cancel-Tool.exe"
    }
  }
}
